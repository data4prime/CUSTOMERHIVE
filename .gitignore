/node_modules

/storage/app/public/*
/storage/logs/*
/storage/storage
# Il symlink (o il file, su ambienti dove non sopravvive come symlink vero -
# vedi docs/refactoring/006-*) va sempre rigenerato con `php artisan
# storage:link`, mai committato: "/*" da solo ignorava solo il contenuto,
# non il symlink stesso, motivo per cui in passato ne e' finito uno tracciato
# con dentro il path del server di staging invece che rigenerato in locale.
/public/storage
/public/storage/*
/vendor
/.idea
Homestead.json
Homestead.yaml
.env
.ftpconfig
.phpunit.result.cache
/public/cookie-name

# I controller creati da interfaccia (module builder di CRUDBooster) restano
# non tracciati, sono specifici di ogni ambiente. I controller "di sistema"
# spostati in System/ (docs/refactoring/006-*) sono invece codice vero e
# proprio del progetto, vanno tracciati - da qui il /* + le eccezioni sotto
# (una singola entry "app/Http/Controllers/" esclude anche i sottoalberi
# negati, git richiede il "/*" per poter re-includere una sottocartella).
app/Http/Controllers/*
!app/Http/Controllers/System/
!app/Http/Controllers/System/**

/.tokensave

# Script locali di supporto (es. seed di dati di test), non fanno parte
# del progetto - restano solo sulla macchina di sviluppo.
/local-scripts
