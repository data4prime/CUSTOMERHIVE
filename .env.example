
APP_PATH=
# Dominio di questa installazione, usato dal sistema di licensing per
# verificare che la licenza corrisponda a questo ambiente (vedi
# docs/login-e-licensing.md). Se contiene un punto, viene usata solo la
# prima parte (es. "dev.thecustomerhive.com" -> "dev").
APP_DOMAIN=
APP_ENV=
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=
#without final /
APP_URL=

SESSION_COOKIE=customerhive_session

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=customerhive
DB_USERNAME=chive_user
DB_PASSWORD=chive_password

# Usati solo da docker-compose (ambiente locale)
MYSQL_ROOT_PASSWORD=root
APP_PORT=8080

# Server di licenza esterno (gestito separatamente, ha i suoi ambienti
# dev/produzione) — su dev locale/staging puntare alla URL del server di
# licenza dev, se diversa da questa.
LICENSE_SERVER_URL=http://license.thecustomerhive.com

# Nuove interfacce del module generator (passo Lista, ...). Spento di default:
# il formato salvato nei controller dei moduli e' lo stesso. Vedi
# docs/refactoring/193 e 194.
MODULE_GENERATOR_WIZARD_V2=false
# Avvisi di scadenza utente: "sync" = invio immediato nel comando; "mail" = in coda "mail" (serve il worker: queue:work qlik_sync --queue=qlik_sync,mail)
MAIL_QUEUE_CONNECTION=sync

# Solo istanze Docker di produzione (immagine docker/Dockerfile.prod): in locale
# lasciare commentate. Vedi docs/refactoring/297.
# Versione mostrata nel footer; se vuota si usa quella di git (git describe).
#APP_VERSION=
# Reverse proxy fidati per X-Forwarded-*: IP/CIDR separati da virgola, oppure *
# Vuota = nessun proxy fidato (comportamento di sempre).
#TRUSTED_PROXIES=
