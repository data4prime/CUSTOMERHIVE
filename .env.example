
APP_PATH=
# Dominio di questa installazione, usato dal sistema di licensing per
# verificare che la licenza corrisponda a questo ambiente (vedi
# docs/login-e-licensing.md). Se contiene un punto, viene usata solo la
# prima parte (es. "dev.thecustomerhive.com" -> "dev").
APP_DOMAIN=
APP_ENV=
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=
#without final /
APP_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=customerhive
DB_USERNAME=chive_user
DB_PASSWORD=chive_password

# Usati solo da docker-compose (ambiente locale)
MYSQL_ROOT_PASSWORD=root
APP_PORT=8080

# Server di licenza esterno (gestito separatamente, ha i suoi ambienti
# dev/produzione) — su dev locale/staging puntare alla URL del server di
# licenza dev, se diversa da questa.
LICENSE_SERVER_URL=http://license.thecustomerhive.com