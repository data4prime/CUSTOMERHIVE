			path: app/Http/Controllers/System/AdminQlikItemsController.php

		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 1
			path: app/Http/Controllers/System/AdminTenantsController.php

		-
			message: '#^Call to static method error\(\) on an unknown class App\\Http\\Controllers\\System\\Log\.$#'
			identifier: class.notFound
			count: 1
			path: app/Http/Controllers/System/ApiController.php

