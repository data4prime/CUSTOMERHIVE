parameters:
	ignoreErrors:
		-
			message: '#^Array has 2 duplicate keys with value ''table'' \("table", "table"\)\.$#'
			identifier: array.duplicateKey
			count: 1
			path: app/Helpers/CRUDBooster.php

		-
			message: '#^Instantiated class App\\Helpers\\Exception not found\.$#'
			identifier: class.notFound
			count: 2
			path: app/Helpers/CRUDBooster.php

		-
			message: '#^Static method Illuminate\\Database\\Connection\:\:select\(\) invoked with 0 parameters, 1\-4 required\.$#'
			identifier: arguments.count
			count: 1
			path: app/Helpers/CRUDBooster.php

		-
			message: '#^Undefined variable\: \$id$#'
			identifier: variable.undefined
			count: 1
			path: app/Helpers/CRUDBooster.php

		-
			message: '#^Array has 2 duplicate keys with value ''pencil\-square'' \(''pencil\-square'', ''pencil\-square''\)\.$#'
			identifier: array.duplicateKey
			count: 1
			path: app/Helpers/IconMap.php

		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 6
			path: app/Helpers/LicenseHelper.php

		-
			message: '#^Method App\\Helpers\\ModuleHelper\:\:update_enabled_tenants\(\) should return bool but return statement is missing\.$#'
			identifier: return.missing
			count: 2
			path: app/Helpers/ModuleHelper.php

		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 5
			path: app/Http/Controllers/System/AdminController.php

		-
			message: '#^Call to an undefined static method App\\Helpers\\QlikHelper\:\:getTicket\(\)\.$#'
